# Copy to .env.local and fill in from Supabase → Project Settings → API.
# The anon key is meant to ship in the browser bundle; it is not a secret.
# NEVER put the service_role key here — it bypasses all row-level security.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
